# Copy to .env (never commit .env). All values are read by the API at startup and validated.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# Public URL(s) of the app, comma separated. Must be https in production.
# Used for CSRF origin checks, secure cookies and OAuth redirects.
APP_ORIGIN=https://app.example.com
# Only if the SPA is hosted on a different origin than the API:
# CORS_ORIGINS=https://www.example.com
# Set when running behind a load balancer / reverse proxy (number of hops, or true).
TRUST_PROXY=1

# --- Storage -----------------------------------------------------------------
# Persistent volume for the SQLite database and uploaded files. Back this up.
DATA_DIR=/data
# UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25
# Built SPA to serve from the API (the Docker image sets this).
# STATIC_DIR=/app/dist

# --- Sessions ----------------------------------------------------------------
SESSION_TTL_HOURS=12
# Secure cookies are forced on automatically when APP_ORIGIN is https.
# COOKIE_SECURE=true

# --- AI assistant ----------------------------------------------------------------
# none    = assistant replies that AI is not configured.
# service = use the AI_Assistant_Code service (FastAPI). Setup: `npm run ai:setup`, run: `npm run dev:all`.
AI_PROVIDER=none
# AI_SERVICE_URL=http://127.0.0.1:8090
# Shared secret between this API and the AI service. Required (32+ chars) in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AI_SERVICE_TOKEN=

# --- AI service settings (read by AI_Assistant_Code from this same .env) --------------
# Fast tier (most questions). Default: ollama in development, hosted in production.
# AI_FAST_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen3:8b
# Hosted open-source model, any OpenAI-compatible API. Examples:
#   Groq        https://api.groq.com/openai/v1
#   Together    https://api.together.xyz/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   DeepInfra   https://api.deepinfra.com/v1/openai
# Pick the model id from the provider's model list (e.g. a Llama / Qwen / DeepSeek instruct model).
# AI_HOSTED_NAME=groq
# AI_HOSTED_BASE_URL=
# AI_HOSTED_API_KEY=
# AI_HOSTED_MODEL=
# Top tier (complex questions / "Deep analysis"): anthropic | openai (any OpenAI-compatible) | none
# AI_TOP_PROVIDER=anthropic
# AI_TOP_API_KEY=
# AI_TOP_MODEL=claude-opus-5-5
# AI_TOP_BASE_URL=https://api.openai.com/v1
# Routing & cost control
# AI_ROUTING_MODE=auto              # auto | fast | top
# AI_COMPLEX_THRESHOLD=4            # lower = more questions go to the top model
# AI_TOP_DAILY_LIMIT_PER_ORG=200    # 0 = unlimited
# AI_REDACT_PII=true                # mask PAN/Aadhaar/mobile/e-mail before calling hosted models
# AI_CACHE_TTL_SECONDS=600

# --- Identity verification (Individual users) ----------------------------------
# disabled | sandbox | mock | digilocker
#   sandbox    – local DigiLocker simulator (full OAuth/PKCE flow, test identities, OTP 123456). Dev/test only.
#   mock       – instant "verified" without any DigiLocker screen. Dev/test only.
#   digilocker – real DigiLocker (needs partner credentials below).
# sandbox and mock are refused when NODE_ENV=production.
KYC_MODE=disabled
# Individuals must be verified before using assets / ITR / documents (default true when KYC is on).
# KYC_REQUIRED=true
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=
# DIGILOCKER_REDIRECT_URI=https://app.example.com/api/kyc/digilocker/callback

# --- ITR e-filing ----------------------------------------------------------------
# Submission stays blocked until an approved ERI provider adapter is implemented.
ITR_PROVIDER=none

# --- Development only ----------------------------------------------------------
# SEED_DEMO=true   # refused when NODE_ENV=production
